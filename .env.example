# Copy to .env locally (or frontend/.env.local for frontend-only config).
# Never commit real credentials or private keys.
# Populate chain and contract values ONLY after verifying against official testnet sources.
# Note: Any VITE_* variable is bundled into public browser code — NEVER put secrets in VITE_* variables.

# Verified Target EVM Testnet Configuration
VITE_CHAIN_ID=
VITE_RPC_URL=
VITE_EXPLORER_URL=

# Verified Testnet Contract Addresses
VITE_TOKEN_ADDRESS=
VITE_VAULT_ADDRESS=

# PQC Verification Service URL (browser-exposed Vite variable + service base URL)
VITE_PQC_SERVICE_BASE_URL=http://127.0.0.1:8000
PQC_SERVICE_BASE_URL=http://127.0.0.1:8000

# Optional: WalletConnect Cloud Project ID (leave blank to use injected EIP-6963 browser wallets only)
VITE_WALLET_CONNECT_PROJECT_ID=

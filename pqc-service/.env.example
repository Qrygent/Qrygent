# Copy to pqc-service/.env locally. NEVER commit real private keys.
# TESTNET / DEVELOPMENT ONLY.

PORT=8000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Required for issuing real ECDSA EIP-712 attestations.
# Must be a 32-byte 0x-prefixed hex private key for a dedicated, restricted testnet verifier account.
# NEVER reuse a personal wallet key or commit this value.
VERIFIER_ATTESTATION_PRIVATE_KEY=

# Optional chain / vault binding enforcement (populate once verified testnet deployment exists).
# When set, the verifier rejects requests with mismatched chainId or vault address.
EXPECTED_CHAIN_ID=
EXPECTED_VAULT_ADDRESS=

# Attestation short-lived TTL cap in seconds (default: 120s)
MAX_ATTESTATION_TTL_SECONDS=120

# Path to local untracked JSON store for registered public keys and security audit logs
REGISTRY_STORE_PATH=./data/registry-store.json

# Required for persistent Vercel serverless deployment (auto-injected by Upstash Redis on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
